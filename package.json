{
  "name": "nexoo-cloud",
  "version": "1.0.0",
  "description": "NEXOO Cloud desktop client",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build && tsc --project tsconfig.json",
    "build:mac": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.nexoo.cloud",
    "productName": "NEXOO Cloud",
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "NEXOO Cloud Installer",
      "background": "assets/dmg-background.png",
      "contents": [
        { "x": 110, "y": 150, "type": "file" },
        { "x": 240, "y": 150, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
